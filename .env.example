FLASK_SECRET_KEY=change-this-to-a-random-secret

# Gmail SMTP
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
MONITOR_EMAIL=

# Run configuration
SEARCH_KEYWORD=Singing Bowls
DAILY_SEND_LIMIT=100
SEND_DELAY=3

# Optional Gemini classification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Google Custom Search discovery
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
